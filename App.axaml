<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="dokkaebi_os.App"
             xmlns:local="using:dokkaebi_os"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <FontFamily x:Key="NotoSansKR">
            avares://dokkaebi-os/Assets/Fonts#Noto Sans CJK KR
        </FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector=":is(TopLevel)">
            <Setter Property="FontFamily" Value="{StaticResource NotoSansKR}" />
        </Style>
    </Application.Styles>
</Application>
