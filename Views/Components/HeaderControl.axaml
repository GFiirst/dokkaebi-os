<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewmodels="using:dokkaebi_os.ViewModels"
             x:Class="dokkaebi_os.Views.Components.HeaderControl"
             x:DataType="viewmodels:BatteryViewModel"
             >
    
    <Border Background="#FF0E0E0E" Padding="50 0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="I/O LOCK |||||||||| S 30ms"
                Foreground="White"
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                FontSize="14"
            />

            <Border
                Grid.Column="1"
            >
                <Grid ColumnDefinitions="*, auto">
                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding Status, StringFormat={}{0}%}"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        FontSize="14"
                        Margin="0 0 3 0"
                    />
                    <Border
                        Grid.Column="1"
                        Width="16"
                        Height="8"
                        ClipToBounds="True"
                        IsHitTestVisible="False"
                    >
                        <Border
                            Width="{Binding BatteryFillWidth}"
                            HorizontalAlignment="Left"
                            Background="#e8e534"
                        />
                    </Border>
                    <Image
                        Grid.Column="1"
                        Source="/Assets/battery.png"
                        Width="20"
                        VerticalAlignment="Center"
                    />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
