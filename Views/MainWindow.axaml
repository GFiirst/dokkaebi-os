<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:dokkaebi_os.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="dokkaebi_os.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/dokka.ico"
        Title="Dokkaebi OS">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Column="0"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#FF0E0E0E"
                Padding="50 0"
            >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="I/O LOCK |||||||||| S 30ms"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="89%"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>

                </Grid>
            </Border>
            <Border
                Grid.Row="1"
                Background="#252525"
                Padding="50 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                    Grid.Column="0"
                        Text="Sort by status"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"/>
                    <TextBlock
                        Grid.Column="1"
                        Text="Show favorites"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"/>
                    <TextBlock
                        Grid.Column="2"
                        Text="Hide trusted"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>
                </Grid>
            </Border>
            
            <Border
                Grid.Row="2"
                >
                <Grid>
                    <Image
                        Source="/Assets/dokkatexturewallpaper.png"
                        Stretch="UniformToFill"/>
                        
                    <TextBlock Text="Welcome to Dokkaebi OS!"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
        <Grid
            Grid.Column="1"
        >
            <Border
                Background="#2d4754"
            >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.Background>
                            <ImageBrush
                                Source="/Assets/sidebackground.png"
                                Stretch="UniformToFill"
                            />
                        </Grid.Background>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid
                            Grid.Row="0"
                        >
                            <Image
                                Source="/Assets/dokka.png"
                                Width="200"
                                Height="200"
                            />
                        </Grid>
                        <Grid
                            Grid.Row="1"
                        >   
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="10"/>
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Text="DOKK OS"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Foreground="#e8e534"
                                FontSize="20"
                            />
                            <TextBlock 
                                Grid.Row="1"
                                Text="dist 1250"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Foreground="white"
                                FontSize="10"
                            />
                        </Grid>                       
                    </Grid>
                    <Grid></Grid>

                    <Grid></Grid>

                    <Grid></Grid>

                    <Grid></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
