<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:dokkaebi_os.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="dokkaebi_os.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/dokka.ico"
        Title="Dokkaebi OS">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Column="0"
        >
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition Height="45"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Background="#FF0E0E0E"
                Padding="50 0"
            >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="I/O LOCK |||||||||| S 30ms"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        FontSize="14"
                    />

                    <TextBlock
                        Grid.Column="1"
                        Text="89%"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        FontSize="14"
                    />

                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Background="#252525"
                Padding="50 0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Text="Sort by status"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        FontSize="14"
                    />
                    <TextBlock
                        Grid.Column="1"
                        Text="Show favorites"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        FontSize="14"/>
                    <TextBlock
                        Grid.Column="2"
                        Text="Hide trusted"
                        Foreground="White"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        FontSize="14"/>
                </Grid>
            </Border>
            
            <Border
                Grid.Row="2"
                >
                <Grid>
                    <Grid.Background>
                        <ImageBrush
                            Source="/Assets/dokkatexturewallpaper.png"
                            Stretch="UniformToFill"/>
                    </Grid.Background>   
                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        Margin="50 0"
                    >   
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock 
                            Grid.Column="0"
                            Text="[X]"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            FontSize="12"
                            Margin="0 0 7 0"
                        />
                        <TextBlock 
                            Grid.Column="1"
                            Text="Status"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            FontSize="12"
                        />
                        <TextBlock 
                            Grid.Column="2"
                            Text="Source"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            FontSize="12"
                        />
                        <TextBlock 
                            Grid.Column="3"
                            Text="Protocol"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            FontSize="12"
                        />
                        <TextBlock 
                            Grid.Column="4"
                            Text="Infos"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="White"
                            FontSize="12"
                        />
                    </Grid>
                    <Border
                        Grid.Row="1"
                        BorderBrush="White"
                        BorderThickness="0 0 0 1"    
                        Margin="80 0 80 5"
                        VerticalAlignment="Center"
                    ></Border>
                    
                    <Grid
                        Grid.Row="2"
                        Margin="50 2"
                    >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border 
                            Grid.Column="0"
                            BorderBrush="White"
                            BorderThickness="2"   
                        >
                            <Grid
                                Background="#FF0E0E0E"
                                Margin="4"
                            >
                            </Grid>
                        </Border>

                        <Border 
                            Grid.Column="1"
                            BorderBrush="White"
                            BorderThickness="2"   
                        >
                            <Grid
                                Background="#FF0E0E0E"
                                Margin="4"
                            >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    BorderBrush="White"
                                    BorderThickness="0 0 1 0"
                                >
                                    <TextBlock 
                                        Grid.Column="0"
                                        Text="???"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        FontSize="12"/>
                                </Border>

                                <Border
                                    Grid.Column="1"
                                    BorderBrush="White"
                                    BorderThickness="0 0 1 0"
                                >
                                    <TextBlock 
                                        Text="92:B1:B8:42:D1:85"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        FontSize="12"/>
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    BorderBrush="White"
                                    BorderThickness="0 0 1 0"
                                >
                                    <TextBlock 
                                        Grid.Column="0"
                                        Text="FDMA"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        FontSize="12"/>
                                </Border>

                                <Border
                                    Grid.Column="3"
                                >
                                    <TextBlock 
                                        Grid.Column="0"
                                        Text="4878 > [ACK:2] (relative se"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        FontSize="12"/>
                                </Border>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid
            Grid.Column="1"
        >
            <Border
                Background="#2d4754"
            >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.Background>
                            <ImageBrush
                                Source="/Assets/sidebackground.png"
                                Stretch="UniformToFill"
                            />
                        </Grid.Background>
                        
                        <Grid.RowDefinitions>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid
                            Grid.Row="0"
                        >
                            <Image
                                Source="/Assets/dokka.png"
                                Width="200"
                                Height="200"
                            />
                        </Grid>
                        <Grid
                            Grid.Row="1"
                        >   
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="10"/>
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Text="DOKK OS"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Foreground="#e8e534"
                                FontSize="20"
                            />
                            <TextBlock 
                                Grid.Row="1"
                                Text="dist 1250"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Foreground="white"
                                FontSize="10"
                            />
                        </Grid>                       
                    </Grid>
                    <Grid>
                        
                    </Grid>

                    <Grid></Grid>

                    <Grid></Grid>

                    <Grid></Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
