<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:dokkaebi_os.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="dokkaebi_os.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/dokka.ico"
        Title="Dokkaebi OS">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="45"/>
            <RowDefinition Height="45"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="#FF0E0E0E"
            Padding="50 0"
        >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Text="I/O LOCK |||||||||| S 30ms"
                    Foreground="White"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>

                <TextBlock
                    Grid.Column="1"
                    Text="89%"
                    Foreground="White"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"/>

            </Grid>
        </Border>
        <Border
            Grid.Row="1"
            Background="#252525"
            Padding="50 0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                Grid.Column="0"
                    Text="Sort by status"
                    Foreground="White"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"/>
                <TextBlock
                    Grid.Column="1"
                    Text="Show favorites"
                    Foreground="White"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"/>
                <TextBlock
                    Grid.Column="2"
                    Text="hide trusted"
                    Foreground="White"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        
        <Border
            Grid.Row="2"
            >
            <Grid>
                <Image
                    Source="/Assets/dokkatexturewallpaper.png"
                    Stretch="UniformToFill"/>
                    
                <TextBlock Text="Welcome to Dokkaebi OS!"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
